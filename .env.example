# CryptoPulse AI — local environment template.
# Copy to `.env` (never commit `.env`). Every value here is a non-secret local default.
# `local_change_me` is a LOCAL-ONLY example password; real environments must override it.

APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose `postgres` service) ---
POSTGRES_USER=cryptopulse
POSTGRES_PASSWORD=local_change_me
POSTGRES_DB=cryptopulse
# Host port published for local tools (psql, tests run from the host).
POSTGRES_HOST_PORT=5432

# SQLAlchemy URL used by the API, migrations and workers.
# Inside Docker the host is `postgres`; from the host machine use `localhost:${POSTGRES_HOST_PORT}`.
DATABASE_URL=postgresql+psycopg://cryptopulse:local_change_me@postgres:5432/cryptopulse
# Server used by integration tests. Tests create and drop their own throwaway databases on it;
# they never touch the database named in DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://cryptopulse:local_change_me@postgres:5432/postgres

# --- API ---
API_HOST_PORT=8000
PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Web ---
WEB_HOST_PORT=3000
# NEXT_PUBLIC_* values are embedded in browser bundles at build time: never put credentials here.
# This is the API address as seen by the *browser* (host machine), not by containers.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Market data (Binance Spot public market-data endpoints only; no API keys) ---
BINANCE_REST_BASE=https://data-api.binance.vision
BINANCE_WS_BASE=wss://data-stream.binance.vision:443
SUPPORTED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
PRIMARY_CANDLE_INTERVAL=1m
PREDICTION_HORIZONS_MINUTES=15,30,60,240
MAX_CANDLE_STALENESS_SECONDS=120

# --- Models ---
MODEL_ARTIFACT_DIR=/app/artifacts/models

# Demo/fixture mode is OFF by default and must never be enabled in production.
ENABLE_DEMO_MODE=false
